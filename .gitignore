# Python caches and local environments
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Local logs, temporary files and platform metadata
**/*.log
**/*.tmp
**/.DS_Store
**/Thumbs.db

# Generated build and delivery artifacts
**/build/
**/dist/
**/release/
**/*.exe

# Bootstrap staging directories
**/.*.bootstrap-*/
**/.tmp/
